{
  "manifest_version": 3,
  "name": "NYT Crossword Paper Filler",
  "version": "1.0.0",
  "description": "Scan your completed paper crossword puzzles and automatically fill them into the NYT web interface",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.nytimes.com/crosswords/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.nytimes.com/crosswords/*"],
      "js": ["content/content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/*"],
      "matches": ["https://www.nytimes.com/*"]
    }
  ]
}
